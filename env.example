# Example environment variables for homelab-infrastructure-ingestion
# Copy this to a file named `.env` and fill values as needed.

# Git repo to index
HOMELAB_GIT_URL=git@github.com:your-org/your-repo.git
# Local path where the repo will be cloned
LOCAL_GIT_PATH=/tmp/homelab-repo

# MongoDB connection and collection settings
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rag
MONGO_COLLECTION=code_chunks

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codebase
# Optional API key for Qdrant (if your instance requires it)
QDRANT_API_KEY=

# Embedding model to use
EMBEDDING_MODEL=text-embedding-3-small
